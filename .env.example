# Copy to .env. Every setting is COLDCHAIN_-prefixed; see src/coldchain/config.py.
COLDCHAIN_ENV=dev                       # dev | test | prod (prod requires API keys)
COLDCHAIN_LOG_JSON=false

COLDCHAIN_DATABASE_URL=postgresql+psycopg://coldchain:coldchain@localhost:5432/coldchain

# LLM: openai | deepseek | ollama (all via the OpenAI-compatible API)
COLDCHAIN_LLM_PROVIDER=openai
COLDCHAIN_LLM_MODEL=gpt-4o-mini
COLDCHAIN_LLM_API_KEY=
# COLDCHAIN_LLM_BASE_URL=http://localhost:11434/v1   # e.g. Ollama with qwen2.5:7b

# Embeddings: "openai" for real semantic search, "hash" for offline dev/CI.
# Changing the dimension needs a fresh database (it is fixed in the vector column).
COLDCHAIN_EMBEDDING_PROVIDER=hash
COLDCHAIN_EMBEDDING_DIM=384
# COLDCHAIN_EMBEDDING_PROVIDER=openai
# COLDCHAIN_EMBEDDING_MODEL=text-embedding-3-small
# COLDCHAIN_EMBEDDING_DIM=1536

# API auth: JSON list. Empty disables auth (dev only).
COLDCHAIN_API_KEYS=[]
